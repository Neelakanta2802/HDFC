MONGODB_URL=mongodb://localhost:27017/mern_banking_portal

# Backend Server Port
PORT=3000

# Secret Key for JWT Token Signing
JWT_SECRET_KEY=your_jwt_secret_key_here

# Frontend Client URL (for CORS in production)
CLIENT_URL=http://localhost:5173
